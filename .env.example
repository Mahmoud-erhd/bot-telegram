# Telegram Configuration
M_AUTOMATION_BOT_TOKEN=your-telegram-bot-token
M_AUTOMATION_SUPER_ADMIN_IDS=123456789
TELEGRAM_POLL_TIMEOUT=25

# Storage and AES-256 Encryption
M_AUTOMATION_DB_PATH=runtime/store.db
M_AUTOMATION_DATA_KEY=generate-random-64-hex-value

# Store Branding
STORE_BRAND_NAME=Mohamed Payment Store
STORE_CURRENCY_CODE=EGP
STORE_CURRENCY_NAME=Egyptian pound

# Payment & Topups (Cashup API)
TOPUPS_ENABLED=1
CASHUP_ENABLED=true
CASHUP_BASE_URL=https://cashup.cash/base
CASHUP_API_KEY=your-cashup-api-key
CASHUP_APP_ID=your-cashup-app-id
